# EP2C5 experiment: raster output + libjpeg-turbo (Pillow) upsampling with the largest row buffer that fits
#   build:  cd boards/ep2c5/fpga_raster_box && quartus_sh --flow compile jpeg_fpga_raster
#   program (USB-Blaster): quartus_pgm -m jtag -o "p;output_files/jpeg_fpga_raster.sof"
set_global_assignment -name FAMILY "Cyclone II"
set_global_assignment -name DEVICE EP2C5T144C8
set_global_assignment -name TOP_LEVEL_ENTITY fpga_top
set_global_assignment -name VERILOG_INPUT_VERSION SYSTEMVERILOG_2005
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS 2
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/jpeg_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/jpeg_sdp_ram.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/jpeg_blockram.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/jpeg_parser.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/jpeg_bitreader.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/jpeg_coefdec.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/jpeg_idct.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/jpeg_ycc2rgb.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/jpeg_pixgen.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/jpeg_raster.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/jpeg_dec_small.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/jpeg_bitwin.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/jpeg_huffdec.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/jpeg_idct_fast.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/jpeg_mcuout.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/jpeg_raster_fast.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/jpeg_dec_fast.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/jpeg_decoder.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/uart_tx.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/jpeg_rom.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/fpga_top.sv
set_global_assignment -name SDC_FILE jpeg_fpga_raster.sdc
# ROM contents (generated by scripts/jpeg_to_hex.py, tb/corpus/board_352x32_q6_420.jpg, 2 MCU rows at the 9216-byte width limit)
set_parameter -name ROM_HEX "jpeg_rom.hex"
set_parameter -name ROM_LENGTH 1016
set_parameter -name ROM_ADDR_BITS 10
set_parameter -name BAUD 115200
# EXPECTED_CHK must be given in DECIMAL: Quartus 13 treats a Verilog literal here as a string
set_parameter -name EXPECTED_CHK 1002394176
# post-fit netlist + SDF for gate-level simulation (quartus_eda), see ../gls/
set_global_assignment -name EDA_SIMULATION_TOOL "ModelSim (Verilog)"
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT "VERILOG HDL" -section_id eda_simulation
set_global_assignment -name EDA_NETLIST_WRITER_OUTPUT_DIR simulation/modelsim -section_id eda_simulation
set_global_assignment -name EDA_TIME_SCALE "1 ps" -section_id eda_simulation
# ---- pin assignments: EP2C5T144 mini dev board (VERIFY against your board's schematic!)
# PIN_17 = 50 MHz oscillator, PIN_144 = push button (active low), PIN_3/7/9 = LEDs D2/D4/D5,
# PIN_41 = header GPIO used as UART TX -> RXD of a 3.3 V USB-serial adapter (GND common)
# (PIN_40 was an input button in the owner's 2022 projects, so it is left alone)
set_location_assignment PIN_17 -to clk
set_location_assignment PIN_144 -to key_n
set_location_assignment PIN_3 -to led_n[0]
set_location_assignment PIN_7 -to led_n[1]
set_location_assignment PIN_9 -to led_n[2]
set_location_assignment PIN_41 -to uart_tx
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to *
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name CYCLONEII_CONFIGURATION_SCHEME "ACTIVE SERIAL"
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"

set_global_assignment -name LAST_QUARTUS_VERSION "13.0 SP1"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_NO_OUTPUT_GND "AS INPUT TRI-STATED"# decoder build options: raster order, sample replication, libjpeg 9 colour (= djpeg 9e -nosmooth)
set_parameter -name RASTER_OUT 1
set_parameter -name FANCY_UPSAMPLE 0
set_parameter -name CC_TURBO 0
set_parameter -name ROWBUF_BYTES 9216
set_parameter -name OUT_FMT 0
set_global_assignment -name CYCLONEII_OPTIMIZATION_TECHNIQUE AREA
